# Base URL of the PreLaunchQA app the worker talks to.
# Preview:  https://project--1756d0c9-9b2e-438d-a365-22f63c423a84-dev.lovable.app
# Live:     https://project--1756d0c9-9b2e-438d-a365-22f63c423a84.lovable.app
PLQ_API_BASE=

# Must match the WORKER_SHARED_SECRET stored in the app's backend secrets.
WORKER_SHARED_SECRET=

# Free-form name for this machine; shown on the job it claims.
WORKER_ID=lightsail-ap-south-1

# Seconds to wait between polls when the queue is empty.
POLL_INTERVAL_SECONDS=10
